root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{c,cc,cpp,cxx,h,hh,hpp,hxx}]
indent_size = 4

[*.py]
indent_size = 4
max_line_length = 100

[*.{json,jsonc,yaml,yml,xml,rviz,urdf,xacro}]
indent_size = 2

[*.{cmake,md,sh,bash,zsh,toml}]
indent_size = 2

[CMakeLists.txt]
indent_size = 2

[Makefile]
indent_style = tab
indent_size = 4

[*.md]
trim_trailing_whitespace = false
